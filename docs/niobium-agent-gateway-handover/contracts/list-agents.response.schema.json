{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.niobium.invalid/agent-gateway/list-agents.response.schema.json",
  "title": "Stage 1 list_agents result",
  "$comment": "Proposed gateway contract only. The .invalid schema hostname is an identifier, not a deployed service. Application authorization and byte limits are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_agent": {
            "$ref": "common.schema.json#/$defs/target_agent"
          },
          "display_name": {
            "type": "string",
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "target_agent",
          "display_name",
          "description"
        ]
      }
    }
  },
  "required": [
    "agents"
  ]
}
