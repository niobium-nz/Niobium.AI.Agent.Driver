{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.niobium.invalid/agent-gateway/start-agent-job.request.schema.json",
  "title": "Stage 2 start_agent_job input",
  "$comment": "Proposed gateway contract only. The .invalid schema hostname is an identifier, not a deployed service. Application authorization and byte limits are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_agent": {
      "$ref": "common.schema.json#/$defs/target_agent"
    },
    "handoff_id": {
      "$ref": "common.schema.json#/$defs/handoff_id"
    },
    "input": {
      "$ref": "common.schema.json#/$defs/input"
    },
    "conversation_key": {
      "$ref": "common.schema.json#/$defs/conversation_key"
    },
    "result_schema": {
      "$ref": "common.schema.json#/$defs/result_schema"
    },
    "completion_mode": {
      "enum": [
        "store_only",
        "notify_parent"
      ]
    },
    "continuation_ref": {
      "$ref": "common.schema.json#/$defs/continuation_ref"
    }
  },
  "required": [
    "target_agent",
    "handoff_id",
    "input",
    "result_schema",
    "completion_mode"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "completion_mode": {
            "const": "notify_parent"
          }
        }
      },
      "then": {
        "required": [
          "continuation_ref"
        ]
      },
      "else": {
        "not": {
          "required": [
            "continuation_ref"
          ]
        }
      }
    }
  ]
}
