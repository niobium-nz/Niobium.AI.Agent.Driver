{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.niobium.invalid/agent-gateway/submit-job-result.request.schema.json",
  "title": "Stage 2 submit_job_result input",
  "$comment": "Proposed gateway contract only. The .invalid schema hostname is an identifier, not a deployed service. Application authorization and byte limits are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "$ref": "common.schema.json#/$defs/job_id"
    },
    "completion_capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "result": {
      "type": "object",
      "maxProperties": 1024
    }
  },
  "required": [
    "job_id",
    "completion_capability",
    "outcome",
    "result"
  ]
}
