{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.niobium.invalid/agent-gateway/dispatch-agent.response.schema.json",
  "title": "Stage 1 dispatch_agent result",
  "$comment": "Proposed gateway contract only. The .invalid schema hostname is an identifier, not a deployed service. Application authorization and byte limits are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_agent": {
      "$ref": "common.schema.json#/$defs/target_agent"
    },
    "handoff_id": {
      "$ref": "common.schema.json#/$defs/handoff_id"
    },
    "dispatch_state": {
      "enum": [
        "accepted",
        "not_dispatched",
        "rejected",
        "outcome_unknown"
      ]
    },
    "accepted_by": {
      "const": "chatgpt"
    },
    "conversation_url": {
      "$ref": "common.schema.json#/$defs/conversation_url"
    },
    "error_code": {
      "$ref": "common.schema.json#/$defs/safe_error_code"
    },
    "retry_advice": {
      "enum": [
        "none",
        "retry_same_event_only",
        "operator_action_required"
      ]
    }
  },
  "required": [
    "target_agent",
    "handoff_id",
    "dispatch_state"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "dispatch_state": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "required": [
          "accepted_by"
        ],
        "properties": {
          "error_code": {
            "type": "null"
          },
          "retry_advice": {
            "const": "none"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "accepted_by"
          ]
        },
        "required": [
          "error_code",
          "retry_advice"
        ],
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
